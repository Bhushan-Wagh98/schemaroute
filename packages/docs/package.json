{
  "name": "@schemaroute/docs",
  "version": "1.0.1",
  "description": "OpenAPI 3.0 spec generator and Swagger UI for SchemaRoute",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev":   "tsup --watch",
    "lint":  "tsc --noEmit"
  },
  "dependencies": {
    "@schemaroute/common": "workspace:*",
    "swagger-ui-express":  "^5.0.1"
  },
  "devDependencies": {
    "@types/express":           "^4.17.21",
    "@types/swagger-ui-express": "^4.1.6",
    "tsup":                     "^8.0.0",
    "typescript":               "^5.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "keywords": ["schemaroute", "openapi", "swagger", "docs", "rest", "api", "typescript"],
  "author": "bhushan-wagh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url":  "https://github.com/Bhushan-Wagh98/schemaroute.git",
    "directory": "packages/docs"
  },
  "homepage": "https://github.com/Bhushan-Wagh98/schemaroute#readme",
  "bugs": {
    "url": "https://github.com/Bhushan-Wagh98/schemaroute/issues"
  }
}
