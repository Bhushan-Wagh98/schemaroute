{
  "name": "@schemaroute/common",
  "version": "1.0.1",
  "description": "Shared TypeScript types for the SchemaRoute ecosystem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev":   "tsup --watch",
    "test":  "vitest run",
    "lint":  "tsc --noEmit"
  },
  "devDependencies": {
    "tsup":       "^8.0.0",
    "typescript": "^5.0.0",
    "vitest":     "^1.0.0"
  },
  "keywords": ["schemaroute", "types", "typescript", "mongoose", "crud"],
  "author": "bhushan-wagh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url":  "https://github.com/Bhushan-Wagh98/schemaroute.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/Bhushan-Wagh98/schemaroute#readme",
  "bugs": {
    "url": "https://github.com/Bhushan-Wagh98/schemaroute/issues"
  }
}
