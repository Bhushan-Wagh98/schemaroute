{
  "name": "@schemaroute/fastify",
  "version": "1.0.3",
  "description": "Fastify adapter for SchemaRoute — auto-generate CRUD routes from a Mongoose schema",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev":   "tsup --watch",
    "test":  "vitest run --passWithNoTests",
    "lint":  "tsc --noEmit"
  },
  "dependencies": {
    "@schemaroute/common": "workspace:*",
    "@schemaroute/core":   "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fastify":     "^4.0.0",
    "tsup":        "^8.0.0",
    "typescript":  "^5.0.0",
    "vitest":      "^1.0.0"
  },
  "peerDependencies": {
    "fastify":  ">=4.0.0",
    "mongoose": ">=7.0.0"
  },
  "keywords": ["schemaroute", "fastify", "mongoose", "crud", "rest", "api", "typescript"],
  "author": "bhushan-wagh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url":  "https://github.com/Bhushan-Wagh98/schemaroute.git",
    "directory": "packages/fastify"
  }
}
